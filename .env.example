# Node reads these when started with --env-file=.env (never commit real secrets).
ADMIN_EMAIL=itsazizsaidi@gmail.com
ADMIN_NOTIFICATION_EMAIL=itsazizsaidi@gmail.com
MAIL_MODE=local
# Local verification emails: data/mail-preview/*.txt (never sent).
# For production: MAIL_MODE=resend, HTTPS origin and persistent data directory.
# SITE_ORIGIN=https://your-domain.example
# RESEND_API_KEY=
# MAIL_FROM=LIMINAL <hello@your-domain.example>
# LIMINAL_DATA_DIR=/persistent/liminal
# HOST=127.0.0.1
# PORT=5180

# Vercel ONLY: public HTTPS address of the persistent backend, no trailing path.
# BACKEND_ORIGIN=https://your-backend.example.com
# Backend ONLY: SITE_ORIGIN must be your public Vercel/custom website origin.
# Never prefix private keys with VITE_; VITE_ variables are exposed to visitors.
