{
  "name": "liminal-production-house",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js --host 127.0.0.1 --configLoader native",
    "build": "vite build --configLoader native",
    "preview": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js preview --host 127.0.0.1 --configLoader native",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test server/*.test.js"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "lucide-react": "^0.468.0",
    "motion": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.9",
    "vite": "^8.3.1"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
